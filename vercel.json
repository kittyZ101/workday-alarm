{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/ics",
      "destination": "/api/ics"
    }
  ],
  "headers": [
    {
      "source": "/shortcut.shortcut",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"workday-alarm.shortcut\"; filename*=UTF-8''%E5%A4%A7%E5%B0%8F%E5%91%A8%E9%97%B9%E9%92%9F.shortcut"
        }
      ]
    }
  ]
}
